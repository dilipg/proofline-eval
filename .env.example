# Copy to .env and fill in your own values. Never commit .env.
# This file is a TEMPLATE and is tracked by git: keep every value blank.

# --- Models. Only needed for --judge / --embedder openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_JUDGE_MODEL=gpt-4o-mini
# ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5

# --- Langfuse tracing (optional). Two things go wrong here:
#   * the PUBLIC key starts pk-lf- and the SECRET key starts sk-lf-
#   * cloud.langfuse.com is EU; a US-region project needs us.cloud.langfuse.com
#     Both failures present as a bare 401 on every call.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Storage (optional). Unset boots a private embedded Postgres under .proofline/pgdata
# DATABASE_URL=postgresql://postgres:pl@localhost:5433/postgres
